#-----------------------------------------------------------------------------
# Copy to `.env` for local development. NEVER commit real values.
# In production set these in Netlify → Site configuration → Environment
# variables. Everything here is SERVER-side: none of it is exposed to the
# browser, which is the point of the change.
#-----------------------------------------------------------------------------

# --- Application ------------------------------------------------------------
# Used to build the Zoho redirect URI and invitation links, and to decide
# whether cookies get the Secure attribute. Must be the real origin.
APP_BASE_URL=http://localhost:3000

# Signs session JWTs. 32+ characters. Changing it signs everyone out.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_JWT_SECRET=

# Session lifetime in seconds (default 43200 = 12h; min 300, max 7 days).
AUTH_SESSION_SECONDS=43200

# One-time token that allows creating the FIRST administrator via
# POST /api/auth/bootstrap. Remove it once that account exists.
BOOTSTRAP_TOKEN=

# --- Database ---------------------------------------------------------------
# In production, enable Netlify DB and Netlify injects NETLIFY_DATABASE_URL
# for you. Leave DATABASE_URL unset in that case — the code prefers it, so a
# stale value here would silently win over the real database.
#
# Set it only to point at a Postgres of your own, e.g. a local one for
# development. Left deliberately blank rather than carrying a specimen value:
# an example connection string is the kind of thing that gets pasted straight
# into a production setting, and a build that talks to "localhost" fails in a
# way that takes a while to recognise.
DATABASE_URL=

# --- Zoho Books -------------------------------------------------------------
# A *Server-based Application* client at https://api-console.zoho.in — NOT the
# self-client / JavaScript client the old implicit-grant flow used. The
# authorized redirect URI must be exactly:
#   <APP_BASE_URL>/api/zoho/callback
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=

# Optional. When set it wins over the token stored by Settings → Connect Zoho,
# and disconnecting from the UI is refused. Easier to rotate in an incident.
ZOHO_REFRESH_TOKEN=

# Accounts server for the data centre the Zoho account belongs to.
#   India: https://accounts.zoho.in  |  US: https://accounts.zoho.com
#   EU:    https://accounts.zoho.eu  |  AU: https://accounts.zoho.com.au
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.in

# Leave blank to derive from the accounts domain (India → www.zohoapis.in).
ZOHO_API_DOMAIN=

# Forced onto every proxied request, so a caller cannot address another org.
ZOHO_ORGANIZATION_ID=

# Optional: separate key for encrypting the stored Zoho refresh token.
# Falls back to AUTH_JWT_SECRET when unset.
ZOHO_TOKEN_KEY=

# --- Follow-up reminders ----------------------------------------------------
# Shared secret for invoking the scheduled functions by hand. Netlify's own
# scheduled runs are recognised by their x-netlify-event header and do not need
# it; anything else without it gets a 404.
#   curl -H "x-cron-key: $CRON_SECRET" $APP_BASE_URL/.netlify/functions/followups-due
CRON_SECRET=

# Email, via Resend (https://resend.com). Leave blank and reminder emails are
# skipped — the run still completes and push still fires.
RESEND_API_KEY=
# Must be an address on a domain verified in Resend.
RESEND_FROM=

# Web push, via Firebase Cloud Messaging. From the service-account JSON at
# Firebase console → Project settings → Service accounts → Generate new key.
# Leave blank and push is skipped; email is unaffected.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the whole key including the BEGIN/END lines. Escaped \n is accepted,
# which is how Netlify's UI stores a multi-line value.
FIREBASE_PRIVATE_KEY=

#-----------------------------------------------------------------------------
# BROWSER-SIDE. Unlike everything above, CRA inlines REACT_APP_* at build time
# and ships them in the bundle. These are the Firebase *web app* config, which
# is public by design — it identifies the project, it does not authorise
# anything. The service-account key above is the secret, and must never be
# given a REACT_APP_ prefix.
#-----------------------------------------------------------------------------
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
# Firebase console → Project settings → Cloud Messaging → Web Push certificates.
REACT_APP_FIREBASE_VAPID_KEY=
